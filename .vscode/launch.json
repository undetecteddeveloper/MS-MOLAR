{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Dev status (pipeline map + next dev)",
      "cwd": "${workspaceFolder}/SOURCE",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/SOURCE/scripts/dev-status.mjs",
      "console": "internalConsole",
      "outputCapture": "std",
      "sourceMaps": false,
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
