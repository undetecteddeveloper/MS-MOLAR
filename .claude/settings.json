{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx next *)",
      "Bash(npx tsx *)",
      "Bash(npm run *)",
      "Bash(node scripts/pw/cli.mjs *)"
    ]
  },
  "enabledMcpjsonServers": [],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require((process.env.CLAUDE_PROJECT_DIR||process.cwd())+'/.claude/hooks/session-start.js')\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require((process.env.CLAUDE_PROJECT_DIR||process.cwd())+'/.claude/hooks/prompt-reminder.js')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*(playwright|supabase|vercel).*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require((process.env.CLAUDE_PROJECT_DIR||process.cwd())+'/.claude/hooks/guard.js')\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "composio@composio": true,
    "frontend-design@claude-plugins-official": true
  }
}
